{
  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": true,
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "relative_line_numbers": true,
  "auto_install_extensions": {
    "html": true,
    "catppuccin": true,
    "lua": true,
    "material-icon-theme": true,
    "toml": true,
    "git-firefly": true
  }
}
